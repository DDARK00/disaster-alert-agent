# 공공데이터 서비스키 — 값은 .env 에만 넣고 커밋하지 않는다. 이름 규칙: DSSP_<용도>_SERVICE_KEY (ADR-013)
# 키는 mcp 컨테이너에만 전달된다. API마다 별도 키다(8개 모두 따로 발급).
DSSP_MESSAGE_SERVICE_KEY=              # 긴급재난문자      /V2/api/DSSP-IF-00247  (구 DSSP_SERVICE_KEY)
DSSP_GUIDE_NATURAL_SERVICE_KEY=        # 자연재난 행동요령 /V2/api/DSSP-IF-20588  (구 DSSP_DOING_SERVICE_KEY)
DSSP_GUIDE_SOCIAL_SERVICE_KEY=         # 사회재난 행동요령 /V2/api/DSSP-IF-20589  (신규)
DSSP_GUIDE_LIFE_SERVICE_KEY=           # 생활안전 행동요령 /V2/api/DSSP-IF-20590  (신규)
DSSP_GUIDE_CIVIL_DEFENSE_SERVICE_KEY=  # 민방위 행동요령   /V2/api/DSSP-IF-20591  (신규)
DSSP_SHELTER_SERVICE_KEY=              # 통합대피소        /V2/api/DSSP-IF-10941  (신규)
WEATHER_ALERTS_SERVICE_KEY=            # 기상청 기상특보 조회서비스 (data.go.kr, WthrWrnInfoService) — DSSP 아님, 이름 유지

# [전환 기간] 코드는 새 이름을 먼저 읽고, 비어 있으면 옛 이름(DSSP_SERVICE_KEY, DSSP_DOING_SERVICE_KEY)으로 폴백한다(경고 1회).
#   새 이름을 채웠으면 옛 이름 줄은 지워도 된다. 인라인 주석은 공백 1칸 이상 + '#' 로 쓴다.

# 관측성/평가 (LangSmith) — 값은 .env 에만 넣는다
LANGSMITH_API_KEY=           # LangSmith API 키 (Developer 플랜: 월 5k 트레이스 → 월 한도 설정 권장)
LANGSMITH_TRACING=false      # true 로 켜면 노드·도구 호출이 트레이스로 기록됨 (기본 꺼짐)
LANGSMITH_PROJECT=disaster-advisor

# Kakao Local (mcp 컨테이너 전용). 응답 저장 금지 — 요청 시 라이브 호출만 (ADR-011)
KAKAO_REST_API_KEY=

# 데이터 모드 (backend·mcp 공통, compose 기본도 replay)
DATA_MODE=replay             # replay(저장된 응답) | live(지금 조회, 공공 API 키 필요)

# LLM (모델 교체는 이 값만 바꾼다)
LLM_BACKEND=fake             # fake | openai_compat
LLM_BASE_URL=http://localhost:11434/v1   # 도커에서는 http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_NO_THINK=1               # qwen3 계열의 사고 출력을 끈다

# 선택 값 — 주석을 풀면 기본값을 바꾼다 (아래 값이 코드 기본값, config/settings.py)
# MAX_REWRITES=1             # 검증 반려 시 AI 답변 재작성 횟수 (넘으면 검증된 기본 요약). 로컬 실행만 — compose 는 넘기지 않는다
# LLM_TIMEOUT=120            # LLM 호출 제한 시간(초). 로컬 실행만
# CORS_ORIGINS=*             # 백엔드 직접 호출 허용 출처. 로컬 실행만 (도커는 nginx 같은 출처 /api/)
# DEMO_FAULTS=0              # 1 = 시연용 장애 주입 허용 (ADR-021). 공개 배포에서 켜지 않는다. 녹화 때만 셸에서 DEMO_FAULTS=1 docker compose up -d backend


# 도커 전용 (compose 가 읽는다)
LLM_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
FRONTEND_PORT=8080
