# raw API captures that still contain keys must never be committed
data/fixtures/_raw_unsanitized/

# 호출 카운터는 로컬 상태
data/fixtures/_call_counter.json
data/fixtures/_call_counter.tmp

# live 모드 호출 결과는 일시적 캡처 (replay 원본 아님)
data/fixtures/*/*_live__*.json

# 공식 API 가이드·원문 복사본은 저장소에 넣지 않는다 (루트 api_spec/ 에 별도 보관)
doc/api_spec/

# 신규 API 응답 원본 (이용허락 확인 전 저장소 제외)
data/fixtures/probe/

# AI 세션 간 인계용 내부 문서 (공개 저장소 제외)
doc/internal/
